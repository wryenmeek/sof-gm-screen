{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": false
  },
  "gitignore": true,
  "ignores": [
    "node_modules/**",
    ".agents/**",
    ".claude/**",
    ".worktrees/**",
    ".infigraph/**",
    ".scratch/**",
    ".cursor/**",
    ".codex/**",
    ".gemini/**",
    "act_output.log",
    ".secrets",
    "test-results/**",
    "playwright-report/**"
  ]
}
